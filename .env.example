# Memorable Egypt — environment variables
#
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# Canonical list per docs 05 (System Architecture), 21 (Security),
# 25 (Deployment). Stale references (e.g. `27-Environment-Variables.md`)
# are ignored per ADR 0001.
#
# Convention:
#   NEXT_PUBLIC_*  → safe to expose to the browser
#   everything else → SERVER-ONLY (never import from client components)

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase ----
# Project URL + anon (public) key. Safe to ship to the browser; access is
# governed by Row-Level Security (docs 07, 21).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — BYPASSES RLS. Server-only. Never in client code.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Mapbox (doc 13) ----
# Public token: used by Mapbox GL JS in the browser + client geocoding UI.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Secret token: server-side geocoding for the "Add New Location" flow only.
MAPBOX_SECRET_TOKEN=

# ---- AI provider (FUTURE — not active in MVP, ADR 0001 decision #3) ----
# Present so env loading doesn't need refactoring when AI is enabled.
GEMINI_API_KEY=

# ---- Monitoring (Phase 7, doc 27) ----
# Optional in dev; set for production. Without a DSN, Sentry is a no-op.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
